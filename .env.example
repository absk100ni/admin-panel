# API URL (defaults to /api/v1 which proxies to localhost:8080 in dev)
VITE_API_URL=

# Sentry DSN (from sentry.io project settings; leave blank to disable)
# Free tier: 5k events/month shared across all apps; client caps events per session.
VITE_SENTRY_DSN=

# Store branding
VITE_STORE_NAME=LucubraElec
VITE_STORE_URL=https://lucubraelec.in

# Admin credentials are backend secrets. Configure ADMIN_EMAIL and
# ADMIN_PASSWORD in the backend environment; never place them in Vite variables.
