# API URL (defaults to /api/v1 which proxies to localhost:8080 in dev)
VITE_API_URL=

# Sentry DSN (from sentry.io project settings; leave blank to disable)
# Free tier: 5k events/month shared across all apps — client caps at 10/session
VITE_SENTRY_DSN=

# Store name (shown in sidebar, title; defaults to 'LucubraElec')
VITE_STORE_NAME=LucubraElecVITE_STORE_URL=https://lucubraelec.in
